# Copy to .env and fill in. Never commit .env.

# --- Classification LLM (Groq) ---
# Labels reviews into the theme catalog during `theme`
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# Model: openai/gpt-oss-120b
# Limits: 30 RPM | 1K RPD | 8K TPM | 200K TPD

# --- Generation LLM (Gemini) ---
# Writes theme descriptions, quotes, actions, and pulse prose
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model: gemini-2.5-flash (override in config.yaml → langchain.generate.model)
# GOOGLE_API_KEY=   # accepted as alias for GEMINI_API_KEY

# --- Phase 3: Google Workspace MCP (Railway) ---
# Public Streamable HTTP endpoint (port is Railway-managed; use HTTPS URL below)
MCP_SERVER_URL=https://mcp-server-google-production.up.railway.app/mcp
# Shared secret if the server set MCP_API_KEY (Authorization: Bearer …)
#MCP_API_KEY=
# Existing Google Doc id or full Docs URL (MCP appends only — cannot create docs)
GOOGLE_DOCS_DOCUMENT_ID=1GrxdD-fvsyLYHcmCgV0fRWLt3dqQoAfqrjS0MhcHYu0
# Gmail draft recipient (self or alias). Overrides config.yaml email_to.
EMAIL_TO=sushmitadasgupta7@gmail.com

# Optional LangSmith tracing (when langchain.tracing: true)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ai-review-pulsator
