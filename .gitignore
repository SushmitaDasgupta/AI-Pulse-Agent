# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Large timestamped raw exports (identity fields) — keep fixture + stable latest pointer visible
data/raw/play_reviews_*.json
!data/raw/play_reviews_fixture.json
!data/raw/play_reviews_latest.json
!data/raw/.gitkeep

# Interim / processed — keep canonical artifacts visible in the IDE
data/interim/*
!data/interim/.gitkeep
!data/interim/reviews.normalized.json
data/processed/*
!data/processed/.gitkeep
!data/processed/reviews.cleaned.json

# Run outputs (optional local noise)
out/*
!out/.gitkeep

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Scraper resume helpers
data/raw/continuation_token.pkl
data/raw/play_reviews_checkpoint.json

# Generated by install_macos_weekly_launchd.sh (machine-local)
scripts/run_weekly_pulse.sh
